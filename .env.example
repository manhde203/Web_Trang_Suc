# Sao chép file này thành ".env" rồi chỉnh sửa giá trị bên dưới trước khi chạy dự án.

# Cổng chạy server Node.js (khác cổng 80/443 của Apache trong XAMPP để không xung đột)
PORT=3000

# Chuỗi bí mật dùng để ký session - PHẢI đổi sang một chuỗi ngẫu nhiên, dài, khó đoán.
# Có thể tự sinh bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-that-dai-va-ngau-nhien

# "production" khi triển khai thật, "development" khi chạy ở máy local
NODE_ENV=development

# ----- Cấu hình MySQL (dùng MySQL đi kèm XAMPP) -----
# Mặc định XAMPP: host 127.0.0.1, cổng 3306, user root, KHÔNG có mật khẩu.
# Nhớ mở XAMPP Control Panel và bấm Start ở dòng MySQL trước khi chạy dự án.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Manhhahaha1@example
DB_NAME=lili_jewelry
