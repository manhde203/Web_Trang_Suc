<%- include('partials/header') %>

<section class="section">
  <div class="container">
    <h1 class="section-title">Giỏ hàng</h1>

    <% if (items.length === 0) { %>
      <div class="empty-state">
        <p>Giỏ hàng của bạn đang trống.</p>
        <a href="/" class="btn btn-primary">Tiếp tục mua sắm</a>
      </div>
    <% } else { %>
      <div class="cart-layout">
        <div class="cart-items">
          <% items.forEach(function(item) { %>
            <div class="cart-item">
              <a href="/san-pham/<%= item.slug %>" class="cart-item-thumb theme-<%= item.color_theme %>">
                <svg viewBox="0 0 64 64" width="34" height="34" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M32 16 L44 26 L38 48 H26 L20 26 Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
              </a>
              <div class="cart-item-info">
                <a href="/san-pham/<%= item.slug %>" class="product-name"><%= item.name %></a>
                <p class="text-muted"><%= formatVnd(item.unitPrice) %> / sản phẩm</p>
              </div>

              <form action="/gio-hang/cap-nhat" method="post" class="cart-qty-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="item_id" value="<%= item.id %>" />
                <input type="number" name="quantity" value="<%= item.quantity %>" min="0" max="20" onchange="this.form.submit()" aria-label="Số lượng" />
              </form>

              <div class="cart-item-total"><%= formatVnd(item.lineTotal) %></div>

              <form action="/gio-hang/xoa" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="item_id" value="<%= item.id %>" />
                <button type="submit" class="cart-remove-btn" aria-label="Xóa sản phẩm">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
                </button>
              </form>
            </div>
          <% }); %>
        </div>

        <aside class="cart-summary">
          <h2>Tóm tắt đơn hàng</h2>
          <div class="summary-row"><span>Tạm tính (<%= itemCount %> sản phẩm)</span><span><%= formatVnd(total) %></span></div>
          <div class="summary-row"><span>Phí vận chuyển</span><span>Miễn phí</span></div>
          <div class="summary-row summary-total"><span>Tổng cộng</span><span><%= formatVnd(total) %></span></div>
          <a href="/thanh-toan" class="btn btn-primary btn-block">Tiến hành thanh toán</a>
          <a href="/" class="btn btn-ghost btn-block">Tiếp tục mua sắm</a>
        </aside>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
