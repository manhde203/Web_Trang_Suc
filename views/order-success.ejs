<%- include('partials/header') %>

<section class="section">
  <div class="container order-success">
    <div class="success-icon" aria-hidden="true">
      <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 12l3 3 5-6"/></svg>
    </div>
    <h1>Đặt hàng thành công!</h1>
    <p class="text-muted">Cảm ơn bạn đã đặt hàng. Mã đơn hàng của bạn là <strong>#<%= order.id %></strong>.</p>

    <div class="order-summary-box">
      <h2>Chi tiết đơn hàng</h2>
      <% items.forEach(function(item) { %>
        <div class="summary-row">
          <span><%= item.product_name %> &times; <%= item.quantity %></span>
          <span><%= formatVnd(item.unit_price * item.quantity) %></span>
        </div>
      <% }); %>
      <div class="summary-row summary-total"><span>Tổng cộng</span><span><%= formatVnd(order.total_amount) %></span></div>
      <hr/>
      <p><strong>Người nhận:</strong> <%= order.guest_name %></p>
      <p><strong>Địa chỉ giao hàng:</strong> <%= order.shipping_address %></p>
      <p><strong>Điện thoại:</strong> <%= order.guest_phone %></p>
    </div>

    <a href="/" class="btn btn-primary">Về trang chủ</a>
  </div>
</section>

<%- include('partials/footer') %>
