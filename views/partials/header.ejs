<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
  <title><%= title %></title>
  <meta name="description" content="Minh Nhật Jewelry - Trang sức bạc cao cấp, tinh xảo, sang trọng." />
  <link rel="stylesheet" href="/public/css/style.css?v=20260826-4" />
  
  <!-- Dán phần CSS của Logo Nhật Minh vào đây -->
  <style>
    /* Căn chỉnh bố cục Logo */
    .brand-logo-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      text-decoration: none;
      width: fit-content;
      padding: 10px;
    }

    .brand-logo-container svg {
      margin-bottom: 5px;
    }

    .brand-text-group {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* Định dạng chữ Nhật Minh */
    .brand-name-main {
      color: #c0392b; 
      font-family: 'Playfair Display', 'Georgia', serif; 
      font-size: 32px;
      font-weight: 700;
      font-style: italic;
      line-height: 1;
      margin-bottom: 5px;
    }

    /* Định dạng chữ JEWELRY */
    .brand-name-sub {
      color: #c0392b; 
      font-family: 'Montserrat', 'Arial', sans-serif;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 5px; 
      text-transform: uppercase;
    }
  </style>
</head>
<body>
  <div class="announce-bar">
    <div class="announce-track">
      <span>10 ngày đổi trả · Miễn phí lấy hàng tận nơi</span>
      <span>Bảo hành 12 tháng · Kiểm hàng trước thanh toán</span>
      <span>Đóng gói hộp da cao cấp</span>
    </div>
  </div>

  <header class="site-header">
    <div class="container header-inner">
      <button class="nav-toggle" id="navToggle" aria-label="Mở menu danh mục" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>

      <!-- Chỉ giữ lại phần HTML và SVG của Logo ở vị trí cũ -->
      <a href="/" class="brand-logo-container">
        <!-- Mã SVG vẽ hình vỏ sò và ngọc trai màu đỏ -->
        <svg viewBox="0 0 200 130" width="100" height="65" xmlns="http://www.w3.org/2000/svg">
          <!-- Vỏ trai ngoài cùng -->
          <path d="M 25 80 C 0 30 40 5 100 5 C 160 5 200 30 175 80" fill="none" stroke="#c0392b" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
          <!-- Vỏ trai giữa -->
          <path d="M 50 80 C 40 35 70 15 100 15 C 130 15 160 35 150 80" fill="none" stroke="#c0392b" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
          <!-- Vỏ trai trong -->
          <path d="M 75 80 C 75 45 85 25 100 25 C 115 25 125 45 125 80" fill="none" stroke="#c0392b" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
          
          <!-- Lượn sóng bên dưới -->
          <path d="M 20 100 C 60 75 130 85 180 100 C 140 120 70 120 20 100 Z" fill="#c0392b" />

          <!-- Đế giữ ngọc trai -->
          <path d="M 55 90 L 80 70 L 100 80 L 120 70 L 145 90 Z" fill="#c0392b" />
          
          <!-- Viên ngọc trai -->
          <circle cx="100" cy="68" r="14" fill="#c0392b" />
          <!-- Điểm sáng bóng trên viên ngọc -->
          <circle cx="95" cy="63" r="3.5" fill="#ffffff" />
        </svg>

        <!-- Phần chữ -->
        <div class="brand-text-group">
          <span class="brand-name-main">Nhật Minh</span>
          <span class="brand-name-sub">JEWELRY</span>
        </div>
      </a>

      <!-- Các phần còn lại giữ nguyên -->
      <form class="header-search" action="/tim-kiem" method="get" role="search">
        <input type="search" name="q" placeholder="Tìm kiếm trang sức..." value="<%= typeof query !== 'undefined' ? query : '' %>" aria-label="Tìm kiếm sản phẩm" />
        <button type="submit" aria-label="Tìm kiếm">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        </button>
      </form>

      <div class="header-actions">
        <!-- ... Code phần actions giữ nguyên ... -->
      </div>
    </div>

    <nav class="category-nav" id="categoryNav">
      <!-- ... Code phần nav giữ nguyên ... -->
    </nav>
  </header>

  <% if (locals.flash) { %>
    <div class="flash flash-<%= flash.type %>" role="status">
      <div class="container"><%= flash.message %></div>
    </div>
  <% } %>

  <main>