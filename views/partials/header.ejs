<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
  <title><%= title %></title>
  <meta name="description" content="LiLi Jewelry - Trang sức bạc cao cấp, tinh xảo, sang trọng." />
  <link rel="stylesheet" href="/public/css/style.css?v=20260826-4" />
</head>
<body>
  <div class="announce-bar">
    <div class="announce-track">
      <span>10 ngày đổi trả · Miễn phí lấy hàng tận nơi</span>
      <span>Bảo hành 12 tháng · Kiểm hàng trước thanh toán</span>
      <span>Đóng gói hộp da cao cấp</span>
    </div>
  </div>

  <header class="site-header">
    <div class="container header-inner">
      <button class="nav-toggle" id="navToggle" aria-label="Mở menu danh mục" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>

      <!-- BẮT ĐẦU PHẦN LOGO ẢNH NHẬT MINH -->
<a href="/" class="brand-logo-container" style="display: flex; align-items: center; justify-content: center; text-decoration: none; position: relative; z-index: 99;">
  <img src="/public/images/logo.png" alt="Nhật Minh Jewelry" class="site-logo" style="max-width: 230px; width: 100%; height: auto; object-fit: contain; display: block; margin-bottom: -40px; transform: translateY(25px); mix-blend-mode: multiply;">
</a>
<!-- KẾT THÚC PHẦN LOGO ẢNH NHẬT MINH -->
      <form class="header-search" action="/tim-kiem" method="get" role="search">
        <input type="search" name="q" placeholder="Tìm kiếm trang sức..." value="<%= typeof query !== 'undefined' ? query : '' %>" aria-label="Tìm kiếm sản phẩm" />
        <button type="submit" aria-label="Tìm kiếm">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        </button>
      </form>

      <div class="header-actions">
        <% if (currentUser) { %>
          <a href="/tai-khoan" class="icon-link" title="<%= currentUser.full_name %>">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
            <span class="icon-label"><%= currentUser.full_name.split(' ').pop() %></span>
          </a>
        <% } else { %>
          <a href="/dang-nhap" class="icon-link" title="Đăng nhập">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
            <span class="icon-label">Đăng nhập</span>
          </a>
        <% } %>
        <a href="/gio-hang" class="icon-link cart-link" title="Giỏ hàng">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6L4 3H2"/><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/></svg>
          <span class="cart-badge"><%= cartCount %></span>
        </a>
      </div>
    </div>

    <nav class="category-nav" id="categoryNav">
      <div class="container category-nav-inner">
        <% if (typeof categories !== 'undefined') { %>
          <% categories.forEach(function(cat) { %>
            <a href="/danh-muc/<%= cat.slug %>" class="<%= currentPath === '/danh-muc/' + cat.slug ? 'active' : '' %>"><%= cat.name %></a>
          <% }); %>
        <% } %>
      </div>
    </nav>
  </header>

  <% if (locals.flash) { %>
    <div class="flash flash-<%= flash.type %>" role="status">
      <div class="container"><%= flash.message %></div>
    </div>
  <% } %>

  <main>
