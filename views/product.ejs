<%- include('partials/header') %>

<div class="container breadcrumb">
  <a href="/">Trang chủ</a> <span>/</span>
  <a href="/danh-muc/<%= product.category_slug %>"><%= product.category_name %></a> <span>/</span>
  <span><%= product.name %></span>
</div>

<section class="section product-detail">
  <div class="container product-detail-grid">
    <div class="product-detail-media theme-<%= product.color_theme %>">
      <% if (product.sale_price) { %><span class="badge badge-sale">Sale</span><% } %>
      <% if (product.is_new) { %><span class="badge badge-new">Mới</span><% } %>
      <svg viewBox="0 0 64 64" width="140" height="140" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="32" cy="32" r="24" stroke="currentColor" stroke-width="1.5"/>
        <path d="M32 12 L48 25 L40 52 H24 L16 25 Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
        <path d="M16 25 H48" stroke="currentColor" stroke-width="1.2"/>
      </svg>
    </div>

    <div class="product-detail-info">
      <p class="product-sku">Mã sản phẩm: <%= product.sku %></p>
      <h1><%= product.name %></h1>

      <div class="rating-row">
        <span class="stars" aria-hidden="true">★★★★★</span>
        <span class="text-muted"><%= product.rating.toFixed(1) %> (<%= product.review_count %> đánh giá)</span>
      </div>

      <div class="product-price product-price-lg">
        <% if (product.sale_price) { %>
          <span class="price-sale"><%= formatVnd(product.sale_price) %></span>
          <span class="price-old"><%= formatVnd(product.price) %></span>
        <% } else { %>
          <span class="price-sale"><%= formatVnd(product.price) %></span>
        <% } %>
      </div>

      <p class="product-description"><%= product.description %></p>

      <ul class="product-specs">
        <li><strong>Chất liệu:</strong> <%= product.material %></li>
        <li><strong>Danh mục:</strong> <%= product.category_name %></li>
        <li><strong>Tình trạng:</strong> <%= product.stock > 0 ? 'Còn hàng (' + product.stock + ' sản phẩm)' : 'Tạm hết hàng' %></li>
      </ul>

      <% if (product.stock > 0) { %>
        <form action="/gio-hang/them" method="post" class="add-to-cart-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="product_id" value="<%= product.id %>" />
          <input type="hidden" name="redirect_to" value="/san-pham/<%= product.slug %>" />
          <label for="qty" class="visually-hidden">Số lượng</label>
          <input type="number" id="qty" name="quantity" value="1" min="1" max="<%= Math.min(product.stock, 20) %>" />
          <button type="submit" class="btn btn-primary">Thêm vào giỏ hàng</button>
        </form>
      <% } else { %>
        <button class="btn btn-disabled" disabled>Tạm hết hàng</button>
      <% } %>

      <div class="trust-badges">
        <span>10 ngày đổi trả</span>
        <span>Bảo hành 12 tháng</span>
        <span>Đóng gói hộp da cao cấp</span>
      </div>
    </div>
  </div>
</section>

<% if (related.length > 0) { %>
<section class="section">
  <div class="container">
    <h2 class="section-title">Sản phẩm liên quan</h2>
    <div class="product-grid">
      <% related.forEach(function(p) { %>
        <%- include('partials/product-card', { product: p }) %>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>
